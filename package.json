{
  "name": "find-my-chiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 WATCHPACK_POLLING=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill:geocode-orgs": "node scripts/backfill-organization-geocodes.mjs",
    "backfill:geocode-orgs:dry": "node scripts/backfill-organization-geocodes.mjs --dry-run",
    "backfill:geocode-orgs:vercel": "npx vercel env pull .env.vercel.pull --environment=production --yes && node --env-file=.env.vercel.pull scripts/backfill-organization-geocodes.mjs",
    "backfill:geocode-orgs:vercel:dry": "npx vercel env pull .env.vercel.pull --environment=production --yes && node --env-file=.env.vercel.pull scripts/backfill-organization-geocodes.mjs --dry-run",
    "backfill:geocode-orgs:vercel:preview": "npx vercel env pull .env.vercel.pull --environment=preview --yes && node --env-file=.env.vercel.pull scripts/backfill-organization-geocodes.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/themes": "^3.1.0",
    "@stripe/stripe-js": "^5.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.86.2",
    "mapbox-gl": "^3.20.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "standardwebhooks": "^1.0.0",
    "stripe": "^17.7.0",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
