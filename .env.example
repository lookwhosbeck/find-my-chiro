# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/rioybgvxkbsmwgqonbaa/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://rioybgvxkbsmwgqonbaa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Storage bucket id for profile photos (must match Dashboard → Storage). Default: avatar
# NEXT_PUBLIC_SUPABASE_AVATAR_BUCKET=avatar

# Optional: server-only. Used to link clinic/organization after signup when RLS blocks the browser from reading the new org row.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mapbox — required for Map View on the search results page.
# Create a free token at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token-here

# Optional: server-only Mapbox token for geocoding practice addresses (recommended; falls back to NEXT_PUBLIC_MAPBOX_TOKEN).
# MAPBOX_ACCESS_TOKEN=your-secret-mapbox-token-here

# Stripe (chiropractor subscriptions) — server
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_ANNUAL=price_...

# Stripe — browser (embedded checkout on /signup)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Production: canonical public origin (no trailing slash). Used for auth/checkout/email fallbacks when Host is missing.
# NEXT_PUBLIC_SITE_URL=https://movynalong.com

# Optional: HMAC secret for guest-checkout signup cookie (falls back to STRIPE_SECRET_KEY if unset)
# CHECKOUT_CLAIM_SECRET=long-random-string

# Supabase Auth (hosted): Site URL = https://movynalong.com ; Redirect URLs include https://movynalong.com/auth/callback (and preview URLs if needed)
# Production: enable "Confirm email" in Supabase (Auth → Providers → Email) so logins stay blocked until verified.
#
# Brevo transactional (Send Email hook → POST your deployed URL + /api/webhooks/supabase-auth-email)
# BREVO_API_KEY=xkeysib-...
# BREVO_SIGNUP_VERIFICATION_TEMPLATE_ID=11
# BREVO_CHIRO_WELCOME_TEMPLATE_ID=12
# CHIRO_WELCOME_LOOM_URL=https://www.loom.com/share/your-welcome-video
# BREVO_PASSWORD_RESET_TEMPLATE_ID=13
# BREVO_CHIRO_PROFILE_NUDGE_TEMPLATE_ID=14
# BREVO_CHIRO_PROFILE_LIVE_TEMPLATE_ID=15
# Referral intro trio (Brevo: E6=17 patient, E5=16 referring copy, E7=18 receiving — adjust if your account differs)
# BREVO_REFERRAL_PATIENT_TEMPLATE_ID=17
# BREVO_REFERRAL_SENDER_COPY_TEMPLATE_ID=16
# BREVO_REFERRAL_RECEIVING_DC_TEMPLATE_ID=18
# Optional: email the referring DC when receiving DC accepts/declines (dashboard is source of truth; leave unset to skip)
# BREVO_REFERRAL_ACCEPTED_TEMPLATE_ID=
# BREVO_REFERRAL_DECLINED_TEMPLATE_ID=
# Do not use Brevo 19 (E8 60-day check) or 20 (E9 milestone) for these unless you retarget those templates.
# Signed links in referral emails (respond URL). Prefer a dedicated secret:
# REFERRAL_ACTION_SECRET=long-random-string
# BREVO_TRANSACTIONAL_SENDER_EMAIL=verified-sender@yourdomain.com
# BREVO_TRANSACTIONAL_SENDER_NAME=Movyn
# SUPABASE_SEND_EMAIL_HOOK_SECRET=v1,whsec_...   (Auth → Hooks → Send Email → signing secret)
#
# Trigger map:
# - E1 (11): signup verify link (Supabase Send Email hook)
# - E2 (12): post-verify welcome + Loom (auth callback/account fallback)
# - E3 (14): 48h nudge if profile completeness is missing required search fields (Vercel cron route)
# - E4 (15): profile live after admin approves license (admin PATCH transition)
# - Referral intros: E6 (17), E5 (16), E7 (18); optional accept/decline pings via BREVO_REFERRAL_*_TEMPLATE_ID
#
# Vercel cron auth secret (used by /api/cron/chiropractor-profile-nudge).
# Set the same CRON_SECRET in Vercel env for production cron invocations.
# CRON_SECRET=long-random-string
